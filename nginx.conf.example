# NGINX Reverse Proxy configuration for WikiTok
# Place this on your NGINX reverse-proxy server (e.g., SWAG or standard NGINX)
# in /etc/nginx/sites-available/wikitok.example.com
# and symlink to /etc/nginx/sites-enabled/

# Rate limiting perimeter zone: 15 requests per second per IP
limit_req_zone $binary_remote_addr zone=wikitok_req_limit:10m rate=15r/s;

server {
    listen 80;
    listen [::]:80;
    server_name wikitok.example.com;

    # Hide NGINX version banner
    server_tokens off;

    # ACME challenge for Let's Encrypt / Certbot renewal
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /var/www/html;
    }

    # Perimeter security: block access to hidden files and directories (except /.well-known/)
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Perimeter security: block common scanning probes and sensitive file extensions
    location ~* \.(env|git|bak|old|save|php|axd|properties|sql|ini|sh|action|application|yaml|yml|conf|config|key|pem|crt)$ {
        deny all;
        return 404;
    }

    # Redirect all other HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name wikitok.example.com;

    # Hide NGINX version banner
    server_tokens off;

    # Restrict request payload size (protect against oversized request attacks)
    client_max_body_size 1M;

    # SSL configuration (adjust certificate paths if necessary)
    #ssl_certificate /etc/letsencrypt/live/wikitok.example.com/fullchain.pem;
    #ssl_certificate_key /etc/letsencrypt/live/wikitok.example.com/privkey.pem;
    ssl_certificate /config/keys/wikitok.example.com-fullchain.pem;
    ssl_certificate_key /config/keys/wikitok.example.com-privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HTTP Strict Transport Security (HSTS)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Modern Browser Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    # Perimeter security: block access to hidden files and directories (except /.well-known/)
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Perimeter security: block common scanning probes and sensitive file extensions
    location ~* \.(env|git|bak|old|save|php|axd|properties|sql|ini|sh|action|application|yaml|yml|conf|config|key|pem|crt)$ {
        deny all;
        return 404;
    }

    # Proxy traffic to WikiTok container (default port 3000)
    location / {
        # Apply rate limiting with burst allowance
        limit_req zone=wikitok_req_limit burst=30 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Request timeouts
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        # Disable buffering for instant streaming responses
        proxy_buffering off;
    }
}
