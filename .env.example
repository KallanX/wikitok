# Host port published by Docker Compose.
PORT=3000

# Optional interface to bind on the host. Leave empty to listen on all interfaces.
BIND_IP=0.0.0.0

# Comma-separated proxy addresses that may set X-Forwarded-For.
# loopback, linklocal, and uniquelocal trust a local reverse proxy.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Requests per minute per client IP for the static app.
RATE_LIMIT_PER_MINUTE=120

# Set to true only if the app is served from paths other than /.
ENABLE_SPA_FALLBACK=false

# Optional MaxMind key used by `docker compose build` to refresh the GeoIP database.
MAXMIND_LICENSE_KEY=
