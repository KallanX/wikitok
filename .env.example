# Host IP binding (0.0.0.0 listens on all interfaces; set to 127.0.0.1 or your private VPN/LAN IP when behind an NGINX reverse proxy)
BIND_IP=0.0.0.0

# Host port mapping for WikiTok (forwarded to container port 3000)
PORT=3000

# Trusted proxy hops. The server ignores X-Forwarded-For unless the direct
# peer matches one of these rules: loopback, linklocal, uniquelocal, an IP, or an IPv4 CIDR.
# Leave uniquelocal out when the published port is reachable from the public internet.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Allowed CORS origins (leave empty for same-origin only; or specify domains like https://wikitok.example.com)
CORS_ORIGIN=

# Rate limit: Maximum allowed requests per minute per IP
RATE_LIMIT_PER_MINUTE=120
